{
  "name": "makeros-product-alpha",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node --watch server/server.mjs\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/server.mjs",
    "build": "vite build",
    "start": "node server/server.mjs",
    "preview": "vite preview",
    "start:server": "node server/server.mjs",
    "check": "node --check server/server.mjs && npx tsc --noEmit --allowJs --checkJs false --jsx react-jsx --moduleResolution bundler --module esnext --target es2022 src/main.jsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "@google/genai": "^1.30.0",
    "firebase": "^12.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
