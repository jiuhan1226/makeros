# 서버 전용 비밀키. VITE_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
DAILY_REQUEST_LIMIT=100
MAX_QUESTIONS_PER_REQUEST=20
MAX_SOURCE_CHARS=30000

# 쉼표로 구분한 허용 프론트 주소. 같은 도메인 통합 배포라면 비워도 됩니다.
# 예: https://makeros.onrender.com,https://makeros.example.com
ALLOWED_ORIGINS=

# Firebase 웹 설정. 공개 가능한 Firebase 클라이언트 구성값입니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Authentication 사용자 UID. 여러 명이면 쉼표로 구분합니다.
VITE_ADMIN_UIDS=

# AI 해설 보안·검증
FIREBASE_PROJECT_ID=
ALLOW_UNAUTHENTICATED_AI=false
EXPLANATION_SIGNING_SECRET=
AI_EXPLANATION_USER_DAILY_LIMIT=30
AI_EXPLANATION_FORCE_RETRY_DAILY_LIMIT=2

# 심사위원 확인용 계정과 학습 데이터 생성에만 사용합니다.
# 클라이언트에 노출되지 않도록 VITE_ 접두사를 사용하지 마세요.
# 실제 계정 정보는 공개 저장소가 아니라 온라인 신청서 또는 심사 안내란으로 전달하세요.
DEMO_ACCOUNT_EMAIL=judge-demo@example.com
DEMO_ACCOUNT_PASSWORD=change-this-demo-password
DEMO_CERTIFICATE_ID=

# seed:demo 스크립트도 같은 값을 사용합니다. VITE_ 값과 다르게 둘 수도 있습니다.
DEMO_ACCOUNT_EMAIL=judge-demo@example.com
DEMO_ACCOUNT_PASSWORD=change-this-demo-password
DEMO_CERTIFICATE_ID=

# 파일럿 검증 결과가 확보된 뒤에만 실제 값을 입력하세요. 데모 수치와 혼용하지 않습니다.
VITE_PILOT_PARTICIPANTS=0
